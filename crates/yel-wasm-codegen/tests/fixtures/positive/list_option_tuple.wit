package yel:listopttup@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-items: func() -> list<option<tuple<s32, s32>>>;
    set-items: func(value: list<option<tuple<s32, s32>>>);
  }
}

world listopttup {
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
