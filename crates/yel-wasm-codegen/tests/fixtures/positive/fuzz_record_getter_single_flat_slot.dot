digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_455" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="r\n: R", class="yel-signal"];
  }
}
