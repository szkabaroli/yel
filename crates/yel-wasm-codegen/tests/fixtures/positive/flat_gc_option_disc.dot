digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_489" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="str\n: option<string>", class="yel-signal"];
    "c0_sig_490" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="res\n: option<result<s32, s64>>", class="yel-signal"];
    "c0_sig_491" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="var\n: option<V>", class="yel-signal"];
    "c0_sig_492" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="nestOpt\n: option<option<s32>>", class="yel-signal"];
  }
}
