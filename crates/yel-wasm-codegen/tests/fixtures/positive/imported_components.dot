digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_411" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="showing\n: bool", class="yel-signal"];
    "c0_sig_412" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="title\n: string", class="yel-signal"];
    "c0_elem_5" [shape=box, style="filled", fillcolor="#e0f7fa", label="Button #5", class="yel-element"];
    "c0_handler_0" [shape=diamond, style=filled, fillcolor="#f3e5f5", label="on clicked", class="yel-handler"];
    "c0_elem_5" -> "c0_handler_0" [label="fires", color="#7e57c2", class="yel-fires"];
  }
}
