digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_global_402 {
    label="global Session";
    style="rounded,dashed";
    color="#b56576";
    "global_sig_403" [shape=ellipse, style="filled,dashed", fillcolor="#fce4ec", label="user-name\n: string", class="yel-signal-global"];
  }
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s403 #3", class="yel-effect"];
    "global_sig_403" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_0" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_elem_4" [shape=box, style="filled", fillcolor="#e0f7fa", label="Button #4", class="yel-element"];
    "c0_handler_0" [shape=diamond, style=filled, fillcolor="#f3e5f5", label="on clicked", class="yel-handler"];
    "c0_elem_4" -> "c0_handler_0" [label="fires", color="#7e57c2", class="yel-fires"];
  }
}
