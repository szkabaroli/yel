package yel:tupbound@0.1.0;

interface shared-types {
  record item {
    n: s32,
    label: string,
  }
}

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-pair: func() -> tuple<s32, string>;
    set-pair: func(value: tuple<s32, string>);
    get-swapped: func() -> tuple<string, s32>;
    set-swapped: func(value: tuple<string, s32>);
    get-both: func() -> tuple<string, string>;
    set-both: func(value: tuple<string, string>);
    get-listed: func() -> tuple<s32, list<s32>>;
    set-listed: func(value: tuple<s32, list<s32>>);
    get-with-record: func() -> tuple<s32, item>;
    set-with-record: func(value: tuple<s32, item>);
    get-with-option: func() -> tuple<s32, option<string>>;
    set-with-option: func(value: tuple<s32, option<string>>);
    get-with-result: func() -> tuple<s32, result<s32, string>>;
    set-with-result: func(value: tuple<s32, result<s32, string>>);
  }
}

world tupbound {
  import shared-types;
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
