digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_485" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="flag\n: bool", class="yel-signal"];
    "c0_sig_486" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="maybe\n: option<s32>", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s485 #3", class="yel-effect"];
    "c0_sig_485" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_fn_2" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="derived-update #2\nwrites maybe", class="yel-fn"];
    "c0_eff_0" -> "c0_fn_2" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_fn_2" -> "c0_sig_486" [label="writes", color="#cc3333", class="yel-writes"];
  }
}
