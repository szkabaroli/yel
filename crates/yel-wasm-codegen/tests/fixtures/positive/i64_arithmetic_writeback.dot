digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_485" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="a\n: s64", class="yel-signal"];
    "c0_sig_486" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="b\n: s64", class="yel-signal"];
    "c0_sig_487" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="u\n: u64", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s485 #3", class="yel-effect"];
    "c0_sig_485" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_0" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_1" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 1\nupdate-b0-s485 #3", class="yel-effect"];
    "c0_sig_486" -> "c0_eff_1" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_1" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_2" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 2\nupdate-b0-s487 #5", class="yel-effect"];
    "c0_sig_487" -> "c0_eff_2" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk5_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_2" -> "c0_blk5_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_elem_0" [shape=box, style="filled", fillcolor="#e0f7fa", label="VStack #0", class="yel-element"];
    "c0_handler_0" [shape=diamond, style=filled, fillcolor="#f3e5f5", label="on clicked", class="yel-handler"];
    "c0_elem_0" -> "c0_handler_0" [label="fires", color="#7e57c2", class="yel-fires"];
    "c0_handler_0" -> "c0_sig_485" [label="writes", color="#cc3333", class="yel-writes"];
    "c0_handler_0" -> "c0_sig_487" [label="writes", color="#cc3333", class="yel-writes"];
    "c0_fn_3" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="update-b0-s485 #3\nb0:root, set text", class="yel-fn"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_fn_3" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_handler_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_fn_5" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="update-b0-s487 #5\nb0:root, set text", class="yel-fn"];
    "c0_handler_0" -> "c0_fn_5" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_blk5_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_fn_5" -> "c0_blk5_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
