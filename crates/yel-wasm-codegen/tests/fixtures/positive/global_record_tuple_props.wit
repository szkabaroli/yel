package yel:grecglob@0.1.0;

interface shared-types {
  record pos {
    x: s32,
    y: s32,
  }
}

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-mirror: func() -> s32;
    set-mirror: func(value: s32);
  }
}

world grecglob {
  import shared-types;
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
