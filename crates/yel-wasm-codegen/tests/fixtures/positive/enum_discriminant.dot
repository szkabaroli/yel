digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_388" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="state\n: Status", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s388 #5", class="yel-effect"];
    "c0_sig_388" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_fn_3" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="if-update-b0 #3\nb0:root", class="yel-fn"];
    "c0_eff_0" -> "c0_fn_3" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_fn_2" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="if-branch-unmount-b2 #2\nb2:if-branch, remove dom", class="yel-fn"];
    "c0_fn_3" -> "c0_fn_2" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_blk2_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="remove dom", class="yel-domsink"];
    "c0_fn_2" -> "c0_blk2_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_fn_1" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="if-branch-mount-b1-b2 #1\nb1:if-anchor, create <Text>, create text", class="yel-fn"];
    "c0_fn_3" -> "c0_fn_1" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_blk1_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="create <Text>", class="yel-domsink"];
    "c0_fn_1" -> "c0_blk1_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_blk1_dom1" [shape=oval, style=filled, fillcolor="#e8f5e9", label="create text", class="yel-domsink"];
    "c0_fn_1" -> "c0_blk1_dom1" [label="updates", color="#2e7d32", class="yel-updates"];
  }
}
