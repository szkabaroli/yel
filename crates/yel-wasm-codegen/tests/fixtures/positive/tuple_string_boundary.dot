digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_456" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="pair\n: tuple<s32, string>", class="yel-signal"];
    "c0_sig_457" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="swapped\n: tuple<string, s32>", class="yel-signal"];
    "c0_sig_458" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="both\n: tuple<string, string>", class="yel-signal"];
    "c0_sig_459" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="listed\n: tuple<s32, list<s32>>", class="yel-signal"];
    "c0_sig_460" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="withRecord\n: tuple<s32, Item>", class="yel-signal"];
    "c0_sig_461" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="withOption\n: tuple<s32, option<string>>", class="yel-signal"];
    "c0_sig_462" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="withResult\n: tuple<s32, result<s32, string>>", class="yel-signal"];
    "c0_sig_463" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="nested\n: tuple<s32, tuple<s32, string>>", class="yel-signal"];
    "c0_sig_464" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="nestedRecord\n: tuple<s32, tuple<Item, s32>>", class="yel-signal"];
  }
}
