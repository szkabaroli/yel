package yel:dragdrop@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-items: func() -> list<string>;
    set-items: func(value: list<string>);
    get-last: func() -> string;
    set-last: func(value: string);
  }
}

world dragdrop {
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
