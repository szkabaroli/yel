digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_403" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="x\n: s32", class="yel-signal"];
    "c0_sig_404" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="y\n: s32", class="yel-signal"];
    "c0_sig_405" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="r\n: f32", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s403 #2", class="yel-effect"];
    "c0_sig_403" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk2_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_0" -> "c0_blk2_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_1" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 1\nupdate-b0-s404 #3", class="yel-effect"];
    "c0_sig_404" -> "c0_eff_1" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_1" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_2" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 2\nupdate-b0-s405 #4", class="yel-effect"];
    "c0_sig_405" -> "c0_eff_2" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk4_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_2" -> "c0_blk4_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
  }
}
