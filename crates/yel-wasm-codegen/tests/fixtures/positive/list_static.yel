package yel:liststatic@0.1.0;

// Exercises `LirExprKind::ListStatic` for both `list<s32>` and `list<string>`.
// list_for_loop covers the string case through iteration, but neither signal
// is exercised purely as a constant data-section literal.
export component App {
    nums: list<s32> = [1, 2, 3];
    tags: list<string> = ["a", "b"];
    VStack {
        Text { "static lists" }
    }
}
