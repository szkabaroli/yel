package yel:fb@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-count: func() -> list<option<s32>>;
    set-count: func(value: list<option<s32>>);
  }
}

world fb {
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
