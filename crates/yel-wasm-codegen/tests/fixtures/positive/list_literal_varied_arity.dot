digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_475" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="empty\n: list<s32>", class="yel-signal"];
    "c0_sig_476" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="one\n: list<s32>", class="yel-signal"];
    "c0_sig_477" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="small\n: list<s32>", class="yel-signal"];
    "c0_sig_478" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="big\n: list<s32>", class="yel-signal"];
    "c0_sig_479" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="huge\n: list<s32>", class="yel-signal"];
  }
}
