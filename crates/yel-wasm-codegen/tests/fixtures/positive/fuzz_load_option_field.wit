package yel:fb@0.1.0;

interface shared-types {
  record rec {
    fa: option<s32>,
    fb: s32,
  }
}

interface app-component {
  use shared-types.{ rec };
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-r: func() -> rec;
    set-r: func(value: rec);
  }
}

world fb {
  import shared-types;
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
