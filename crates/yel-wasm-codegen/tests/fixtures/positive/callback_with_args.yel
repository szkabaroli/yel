// list is dropped somewhere between THIR and WIT emission. A future fix
// should propagate the declared params; once it does, the snapshot diff
// will flag the change for review.
export component Widget {
    export on-select: func(item: s32);

    VStack {
        Text { "widget" }
    }
}
