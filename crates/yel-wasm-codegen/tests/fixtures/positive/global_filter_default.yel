package yel:globfilt@0.1.0;

// A `.filter(...)` inside a global-singleton default. The predicate's
// child expressions (`x > 2`) must resolve through the module-scope
// expression arena — regression guard for the module-scope filter
// carrier (previously handed an empty arena; see TECH_DEBT §1.6).
export global Store {
    evens: list<s32> = [1, 2, 3, 4].filter(|x| x > 2);
}

export component App {
    VStack {
        Text { "filtered" }
    }
}
