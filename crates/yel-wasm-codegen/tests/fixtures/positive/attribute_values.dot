digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_475" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="flag\n: bool", class="yel-signal"];
    "c0_sig_476" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="count\n: s32", class="yel-signal"];
    "c0_sig_477" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="label\n: string", class="yel-signal"];
    "c0_sig_478" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="ratio\n: f32", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s475 #2", class="yel-effect"];
    "c0_sig_475" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk2_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="attr", class="yel-domsink"];
    "c0_eff_0" -> "c0_blk2_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_1" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 1\nupdate-b0-s476 #3", class="yel-effect"];
    "c0_sig_476" -> "c0_eff_1" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk3_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="attr", class="yel-domsink"];
    "c0_eff_1" -> "c0_blk3_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_2" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 2\nupdate-b0-s477 #4", class="yel-effect"];
    "c0_sig_477" -> "c0_eff_2" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk4_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_2" -> "c0_blk4_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_3" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 3\nupdate-b0-s478 #5", class="yel-effect"];
    "c0_sig_478" -> "c0_eff_3" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk5_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="attr", class="yel-domsink"];
    "c0_eff_3" -> "c0_blk5_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_elem_1" [shape=box, style="filled", fillcolor="#e0f7fa", label="Text #1", class="yel-element"];
    "c0_eff_0" -> "c0_elem_1" [label="binds", color="#2e7d32", class="yel-updates yel-binds"];
    "c0_eff_1" -> "c0_elem_1" [label="binds", color="#2e7d32", class="yel-updates yel-binds"];
