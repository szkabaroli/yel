digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_453" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="loaded\n: bool", class="yel-signal"];
    "c0_sig_454" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="label\n: string", class="yel-signal"];
    "c0_eff_0" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 0\nupdate-b0-s453 #3", class="yel-effect"];
    "c0_sig_453" -> "c0_eff_0" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_fn_2" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="derived-update #2\nwrites label", class="yel-fn"];
    "c0_eff_0" -> "c0_fn_2" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_fn_2" -> "c0_sig_454" [label="writes", color="#cc3333", class="yel-writes"];
    "c0_fn_4" [shape=box, style="filled,rounded", fillcolor="#ede7f6", label="update-b0-s454 #4\nb0:root, set text", class="yel-fn"];
    "c0_fn_2" -> "c0_fn_4" [label="calls", color="#6a4ca5", style=dashed, class="yel-calls"];
    "c0_blk4_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_fn_4" -> "c0_blk4_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
    "c0_eff_1" [shape=box, style="filled,rounded", fillcolor="#fff5d6", label="effect 1\nupdate-b0-s454 #4", class="yel-effect"];
    "c0_sig_454" -> "c0_eff_1" [label="reads", color="#3366cc", class="yel-reads"];
    "c0_blk4_dom0" [shape=oval, style=filled, fillcolor="#e8f5e9", label="set text", class="yel-domsink"];
    "c0_eff_1" -> "c0_blk4_dom0" [label="updates", color="#2e7d32", class="yel-updates"];
  }
}
