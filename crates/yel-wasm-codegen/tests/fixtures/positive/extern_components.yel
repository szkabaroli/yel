package yel:embed@0.1.0;

extern component Modal {
    title: string;
    open: bool;
    func show();
    func hide();
}

extern component Glyph {
    name: string;
    size: s32;
}

export component App {
    showing: bool = false;
    title: string = "Welcome";

    VStack {
        HStack {
            Text { "Imported components demo" }
        }

        HStack {
            Button {
                "toggle dialog"
                clicked: { showing = !showing; }
            }
        }
    }
}
