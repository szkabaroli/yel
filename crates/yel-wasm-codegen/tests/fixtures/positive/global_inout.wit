package yel:globinout@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
  }
}

interface session {
  on-user-name-changed: func(v: string);
  set-user-name: func(v: string);
}

world globinout {
  import session;
  import yel:ui/dom@0.1.0;
