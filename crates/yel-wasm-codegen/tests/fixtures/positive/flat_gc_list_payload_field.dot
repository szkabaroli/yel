digraph yel_signal_graph {
  rankdir=LR;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_c0 {
    label="component App (export)";
    style=rounded;
    color="#888";
    "c0_sig_479" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="withList\n: tuple<V, s32>", class="yel-signal"];
    "c0_sig_480" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="withStr\n: tuple<V, s32>", class="yel-signal"];
    "c0_sig_481" [shape=ellipse, style=filled, fillcolor="#eaf4ff", label="plain\n: tuple<V, s32>", class="yel-signal"];
  }
}
