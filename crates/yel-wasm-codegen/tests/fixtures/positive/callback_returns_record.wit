package yel:crb@0.1.0;

interface shared-types {
  record point {
    x: s32,
    y: s32,
  }
}

interface app-component {
  use shared-types.{ point };
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-p: func() -> point;
    set-p: func(value: point);
  }
}

interface app-callbacks {
  use app-component.{ app };
  use shared-types.{ point };
  get-point: func(self: borrow<app>) -> point;
}

world crb {
  import app-callbacks;
  import app-component;
  import shared-types;
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
