package yel:liststringidx@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
    get-items: func() -> list<string>;
    set-items: func(value: list<string>);
  }
}

world liststringidx {
  import yel:ui/dom@0.1.0;
