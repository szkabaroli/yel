package yel:globals@0.1.0;

interface app-component {
  resource app {
    constructor();
    mount: func(root: u32);
    unmount: func();
  }
}

interface theme {
  set-dark-mode: func(v: bool);
  toggle-dark-mode: func();
}

world globals {
  import theme;
  import yel:ui/dom@0.1.0;
  export app-component;
  export yel:ui/dispatch@0.1.0;
}
