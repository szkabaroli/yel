package yel:host;

// Generic host world: every Yel component imports `yel:ui/dom@0.1.0`
// (the only stable host surface). Callback imports (per-component
// `*-callbacks@*` interfaces) and component exports are discovered
// at runtime via `Component::component_type()` and wired through
// wasmtime's untyped `Linker::root().func_new()` API.
world generic-host {
    import yel:ui/dom@0.1.0;
}
