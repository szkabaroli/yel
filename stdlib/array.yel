// The primitive floor, and one function written on top of it.
//
// STATUS: illustration. Nothing here parses — `primitive`, `@unsafe`, `ref` and
// function bodies are all decided but unimplemented (see plans/rewrite/scope.md).
// This file exists to show the shape and to surface what is still missing.
// Three language gaps were found by writing it, listed at the bottom — one of
// them larger than anything already on the surface-break list.

package yel:std@0.1.0;

// ── The floor ───────────────────────────────────────────────────────────────
//
// Primitives are bodyless: the compiler supplies the implementation, named by
// the op string. They speak `ref` only — the uniform reference representation —
// so there is one `array.get` rather than one per element type. That is Grain's
// arrangement, and it is why nothing below needs monomorphizing.
//
// The declared type is checked against the op's real signature at registration,
// so `op = "@typo"` fails there rather than lowering to nothing.

@unsafe
primitive array-len: func(a: ref) -> s32 = "@wasm.ref_array_len";

@unsafe
primitive array-get: func(a: ref, index: s32) -> ref = "@wasm.ref_array_any_get";

@unsafe
primitive array-set: func(a: ref, index: s32, value: ref) = "@wasm.ref_array_any_set";

@unsafe
primitive array-new: func(size: s32, init: ref) -> ref = "@allocate.wasm_array_any_ref";

// Erase to / restore from the uniform representation. `T` in `from-ref` appears
// only in return position, so it is never determined by an argument — the
// bidirectional checker solves it from the expected type, and a position with no
// expected type is an error. That is the correct behaviour: it demands an
// annotation exactly where the cast is genuinely ambiguous.

@unsafe
primitive to-ref: func<T>(value: T) -> ref = "@wasm.fromGrain";

@unsafe
primitive from-ref: func<T>(value: ref) -> T = "@wasm.toGrain";

// ── Above the floor: ordinary yel ───────────────────────────────────────────

export global List {
    len: func<T>(items: list<T>) -> s32 {
        array-len(to-ref(items))
    }

    get: func<T>(items: list<T>, index: s32) -> option<T> {
        let source = to-ref(items);
        if index < 0 { none }
        else if index >= array-len(source) { none }
        else { some(from-ref(array-get(source, index))) }
    }

    // Two passes: count, then fill. The output length is not known up front and
    // there is no way to grow an array, so counting first is the only option
    // that allocates exactly once.
    filter: func<T>(items: list<T>, keep: func(item: T) -> bool) -> list<T> {
        let matched = 0;
        for item in items {
            if keep(item) { matched = matched + 1; }
        }

        // GAP 3 (below): `array-new` needs an initial `ref`, and at this point
        // there is no `T` in hand to make one from. Written as `to-ref(0)` only
        // to keep the example concrete — it is a lie, and the real answer is
        // either a nullable element type or an allocator that takes no init.
        let out = array-new(matched, to-ref(0));

        let next = 0;
        for item in items {
            if keep(item) {
                array-set(out, next, to-ref(item));
                next = next + 1;
            }
        }

        from-ref(out)
    }

    map: func<T, U>(items: list<T>, transform: func(item: T) -> U) -> list<U> {
        let source = to-ref(items);
        let out = array-new(array-len(source), to-ref(0));

        let index = 0;
        for item in items {
            array-set(out, index, to-ref(transform(item)));
            index = index + 1;
        }

        from-ref(out)
    }
}

// ── What writing this surfaced ──────────────────────────────────────────────
//
// GAP 1 — no `return`. `LANGUAGE.md` § Statements lists assignment, compound
//   assignment, let, if and expression statements. There is no return. The
//   Function Bodies section committed earlier uses `return low;` in its `clamp`
//   example — that syntax does not exist and the example is wrong. Everything
//   above is written in tail-expression style, which works, but `get` shows the
//   cost: an early exit becomes a nested if/else chain.
//
// GAP 2 — **there is no loop statement at all.** Worse than first written, and
//   measured: `for` is a *UI node* (`LANGUAGE.md` § List Rendering), not a
//   statement. `LANGUAGE.md` § Statements lists assignment, compound assignment,
//   let, if and expression statements — no `for`, no `while`. Putting a `for`
//   inside a handler body is rejected today:
//
//       Button { clicked: { for i in 0..3 { t = t + i; } } }
//       error[E0060]: expected `}`, found `identifier`
//
//   So **every loop in this file is unwritable**. yel can iterate in a template
//   and not in code, which means `filter`, `map` and every other list operation
//   have no expressible body. This is the largest single blocker for a source
//   stdlib — larger than `primitive`, larger than function bodies — and it was
//   not on any list before this file was written.
//
// GAP 3 — `array-new` requires an initial element and there is nothing sensible
//   to pass. Grain sidesteps this by taking the item at the call site
//   (`allocateArray(length, WasmRef.fromGrain(item))`), which works for `make`
//   but not for `filter`, where the value is not known until the loop runs.
//
// None of these three is in plans/rewrite/scope.md's surface list.
